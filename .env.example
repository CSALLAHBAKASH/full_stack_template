# Local development defaults only. Replace these values before sharing or deployment.
APP_ENV=development
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=devpassword
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
FRONTEND_URL=http://localhost:3000
# Set this to your computer's Wi-Fi IP to access the app from another device.
LAN_HOST=localhost
# Override only if you need a custom origin allowlist; otherwise Compose allows
# localhost:3000 and LAN_HOST:3000.
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.100:3000
PASSWORD_AUTH_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=local-admin-password-change-me

# Optional OIDC provider. Register this callback URL with your provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
